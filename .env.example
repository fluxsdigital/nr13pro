# GitHub personal access token (fine-grained)
# Crie em: https://github.com/settings/tokens?type=beta
# Permissões mínimas p/ leitura: contents, issues, pull requests, metadata
GITHUB_TOKEN=

# ─── API backend ───────────────────────────────────────────────────
# URL base da API NestJS (prefixo global /api).
# Local (padrão, já é o fallback se a var não existir):
NEXT_PUBLIC_API_URL="http://localhost:3333/api"

# Produção: crie um arquivo `.env.production` (gitignored) com a URL pública,
# ex.: NEXT_PUBLIC_API_URL="https://seu-tunnel.trycloudflare.com/api"
# Na Vercel, configure NEXT_PUBLIC_API_URL nas Project Settings → Environment Variables.
# OBS: variáveis NEXT_PUBLIC_* são embutidas no build — alterá-las exige novo build.
